generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       User[]
  manageLogs  AdminManageRole[]
}

model PermissionGroup {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  name        String
  permissions Permission[]
}

model Permission {
  id      Int              @id @default(autoincrement())
  code    String           @unique
  name    String
  groupId Int
  group   PermissionGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  roles   RolePermission[]

  @@index([groupId])
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id                    Int                    @id @default(autoincrement())
  email                 String                 @unique
  passwordHash          String
  fullName              String
  isActive              Boolean                @default(true)
  roleId                Int
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  lastLoginAt           DateTime?
  phone                 String?                @unique @map("phoneNumber")
  role                  Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  auditLogs             AuditLog[]
  Comment               Comment[]
  loginHistory          LoginHistory[]
  confirmedOrders       Order[]                @relation("OrderConfirmedBy")
  orders                Order[]                @relation("OrderCustomer")
  passwordResetTokens   PasswordResetToken[]
  recipientInfos        RecipientInfo[]
  returnsHandled        ReturnRequest[]        @relation("ReturnHandledBy")
  ordersRefunded        ReturnRequest[]        @relation("OrderRefundedBy")
  issuesCreated         StockIssue[]           @relation("IssueCreatedBy")
  issuesHandled         StockIssue[]           @relation("IssueHandledBy")
  receiptsCreated       StockReceipt[]         @relation("ReceiptCreatedBy")
  receiptsHandled       StockReceipt[]         @relation("ReceiptHandledBy")
  changeRequestsCreated AccountChangeRequest[] @relation("ChangeRequestCreatedBy")
  changeRequestsHandled AccountChangeRequest[] @relation("ChangeRequestReviewedBy")
  customer              Customer?
  staff                 Staff?
  shopOwner             ShopOwner?
  admin                 Admin?

  @@index([roleId])
}

model Customer {
  userId         Int             @id
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Staff {
  userId            Int                   @id
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  managedProducts   StaffManageProduct[]
  managedCategories StaffManageCategory[]
}

model ShopOwner {
  userId Int  @id
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Admin {
  userId       Int               @id
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  managedRoles AdminManageRole[]
}

model AuditLog {
  id         Int        @id @default(autoincrement())
  actorId    Int
  action     AuditAction
  entityType String
  entityId   Int?
  details    Json?
  ip         String?
  createdAt  DateTime   @default(now())
  actor      User       @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model AdminManageRole {
  id      Int      @id @default(autoincrement())
  adminId Int
  roleId  Int
  type    String
  at      DateTime @default(now())
  admin   Admin    @relation(fields: [adminId], references: [userId], onDelete: Restrict)
  role    Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([roleId])
}

model RecipientInfo {
  id                   Int     @id @default(autoincrement())
  customerId           Int
  recipientName        String?
  recipientPhoneNumber String
  address              String
  recipientType        String?
  isDefault            Boolean @default(false)
  customer             User    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders               Order[]

  @@index([customerId])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  parentID    Int?
  imageUrl    String?
  products    Product[]

  @@index([isActive])
  @@index([parentID])
}

model Product {
  id                    Int                     @id @default(autoincrement())
  categoryId            Int
  productName           String
  oldPrice              Int
  newPrice              Int
  description           String
  status                ProductStatus           @default(ACTIVE)
  slug                  String                  @unique
  stock                 Int
  isFeature             Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  rate                  Float                   @default(0)
  sold                  Int                     @default(0)
  category              Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  Comment               Comment[]
  pictures              ProductPictures[]
  tags                  Product_Tags[]
  orderItems            Order_contain_product[]
  inventoryTransactions InventoryTransaction[]
  returnRequestItems    ReturnRequestItem[]
  stockIssueItems       StockIssueItem[]
  stockReceiptItems     StockReceiptItem[]
  staffManageLogs       StaffManageProduct[]
}

model ProductPictures {
  productId Int
  url       String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([productId, url])
}

model Product_Tags {
  productId Int
  tag       String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([productId, tag])
}

model Order {
  id                  Int                     @id @default(autoincrement())
  customerId          Int
  recipientId         Int
  confirmedById       Int?
  orderDate           DateTime                @default(now())
  status              OrderStatus
  paymentMethod       String?
  paymentMethodStatus Boolean                 @default(false)
  note                String?
  shippingFee         Int
  discount            Int
  subtotal            Int
  totalCost           Int
  customer            User                    @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  recipient           RecipientInfo           @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  confirmedBy         User?                   @relation("OrderConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  items               Order_contain_product[]
  returnRequests      ReturnRequest[]
}

model Order_contain_product {
  orderId   Int
  productId Int
  quantity  Int
  price     Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([orderId, productId])
}

model Supplier {
  id                Int            @id @default(autoincrement())
  name              String
  businessRegistNum String         @unique
  email             String?        @unique
  phoneNumber       String?
  address           String?
  contactPerson     String?
  bankNumber        String?
  bankName          String?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  receipts          StockReceipt[]
  issues            StockIssue[]
}

model StockReceipt {
  id           Int               @id @default(autoincrement())
  code         String
  status       DocumentStatus    @default(DRAFT)
  content      String
  rejectReason String?
  supplierId   Int
  createdById  Int
  handledById  Int?
  createdAt    DateTime          @default(now())
  handledAt    DateTime?
  supplier     Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy    User              @relation("ReceiptCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  handledBy    User?             @relation("ReceiptHandledBy", fields: [handledById], references: [id], onDelete: Restrict)
  items        StockReceiptItem[]

  @@index([status, createdAt])
  @@index([supplierId])
}

model StockReceiptItem {
  id          Int                   @id @default(autoincrement())
  productId   Int
  receiptId   Int
  quantity    Int                   @default(0)
  unitCost    Int
  product     Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  receipt     StockReceipt          @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  transaction InventoryTransaction?

  @@unique([receiptId, productId])
  @@index([productId])
}

model StockIssue {
  id           Int              @id @default(autoincrement())
  code         String
  type         StockIssueType   @default(SALE)
  status       DocumentStatus   @default(DRAFT)
  content      String
  rejectReason String?
  supplierId   Int?
  createdById  Int
  handledById  Int?
  createdAt    DateTime         @default(now())
  handledAt    DateTime?
  supplier     Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy    User             @relation("IssueCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  handledBy    User?            @relation("IssueHandledBy", fields: [handledById], references: [id], onDelete: Restrict)
  items        StockIssueItem[]

  @@index([status, createdAt])
  @@index([type])
}

model StockIssueItem {
  id          Int                   @id @default(autoincrement())
  productId   Int
  issueId     Int
  quantity    Int                   @default(0)
  unitCost    Int
  issue       StockIssue            @relation(fields: [issueId], references: [id], onDelete: Cascade)
  product     Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  transaction InventoryTransaction?

  @@index([issueId, productId])
  @@index([productId])
}

model InventoryTransaction {
  id              Int                 @id @default(autoincrement())
  type            TransactionType
  productId       Int
  quantity        Int                 @default(0)
  unitCost        Int                 @default(0)
  receiptItemId   Int?                @unique
  issueItemId     Int?                @unique
  returnRequestId Int?
  createdAt       DateTime            @default(now())
  product         Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptItem     StockReceiptItem?   @relation(fields: [receiptItemId], references: [id], onDelete: Restrict)
  issueItem       StockIssueItem?     @relation(fields: [issueItemId], references: [id], onDelete: Restrict)
  returnRequest   ReturnRequest?      @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([type, createdAt])
}

model ReturnRequest {
  id                 Int                    @id @default(autoincrement())
  orderId            Int
  status             ReturnStatus           @default(PENDING)
  reason             String
  rejectReason       String
  createdAt          DateTime               @default(now())
  handledById        Int?
  handledAt          DateTime?
  refundAmount       Int?                   @default(0)
  refundCode         String?                @unique
  beneficiaryAccount String?
  beneficiaryName    String?
  beneficiaryBank    String?
  refundMessage      String?
  refundedById       Int?
  refundedAt         DateTime?
  order              Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  handledBy          User?                  @relation("ReturnHandledBy", fields: [handledById], references: [id], onDelete: Restrict)
  refundBy           User?                  @relation("OrderRefundedBy", fields: [refundedById], references: [id], onDelete: Restrict)
  transactions       InventoryTransaction[]
  items              ReturnRequestItem[]
  images             ReturnImage[]

  @@index([orderId])
  @@index([status, createdAt])
}

model ReturnRequestItem {
  id              Int                @id @default(autoincrement())
  returnRequestId Int
  productId       Int
  condition       ReturnItemCondition?
  quantity        Int
  unitCost        Int
  product         Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnRequest   ReturnRequest      @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId, productId])
  @@index([productId])
}

model ReturnImage {
  id              Int           @id @default(autoincrement())
  returnRequestId Int
  url             String
  uploadedAt      DateTime      @default(now())
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
}

model LoginHistory {
  id        Int      @id @default(autoincrement())
  userId    Int?
  email     String
  ip        String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AccountChangeRequest {
  id            Int                 @id @default(autoincrement())
  requestedById Int
  reviewedById  Int?                @map("handledById")
  reason        String
  changes       Json
  previous      Json
  status        ChangeRequestStatus @default(PENDING)
  createdAt     DateTime            @default(now())
  reviewedAt    DateTime?
  requestedBy   User                @relation("ChangeRequestCreatedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy    User?               @relation("ChangeRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([requestedById])
}

model Comment {
  id        Int      @id @default(autoincrement())
  productId Int
  userId    Int
  content   String
  rating    Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StaffManageProduct {
  id        Int      @id @default(autoincrement())
  staffId   Int
  productId Int
  type      String
  at        DateTime @default(now())
  staff     Staff    @relation(fields: [staffId], references: [userId], onDelete: Restrict)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([productId])
}

model StaffManageCategory {
  id         Int      @id @default(autoincrement())
  staffId    Int
  categoryId Int
  type       String
  at         DateTime @default(now())
  staff      Staff    @relation(fields: [staffId], references: [userId], onDelete: Restrict)

  @@index([staffId])
  @@index([categoryId])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOCK
  UNLOCK
  APPROVE
  REJECT
  ASSIGN_ROLE
  CHANGE_PERMISSIONS
}

enum ProductStatus {
  ACTIVE
  HIDDEN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
}

enum DocumentStatus {
  DRAFT
  PENDING_HANDLE
  APPROVED
  DENIED
}

enum StockIssueType {
  SALE
  DAMAGED
  RETURN_TO_SUPPLIER
}

enum TransactionType {
  RECEIPT
  ISSUE
  CUSTOMER_RETURN
}

enum ReturnStatus {
  PENDING
  APPROVED
  DENIED
  REFUNDED
}

enum ReturnItemCondition {
  RESALEABLE
  NON_RESALEABLE
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
